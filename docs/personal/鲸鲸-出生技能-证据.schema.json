{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.local/schemas/鲸鲸-出生技能-证据.schema.json",
  "title": "出生技能证据",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "step", "status", "case_ids", "source_reviews", "changes", "tests", "acceptance", "rollback", "audit", "finishedAt"],
  "properties": {
    "version": { "const": 1 },
    "step": { "type": "string", "pattern": "^B[0-7]-[0-9]{2}$" },
    "status": { "type": "string", "enum": ["done", "blocked", "failed"] },
    "case_ids": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(GH|BL|DY|EV)-[0-9]{3}$" }
    },
    "source_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "commit", "file", "license", "note"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "commands"],
      "properties": {
        "pass": { "type": "integer", "minimum": 1 },
        "fail": { "const": 0 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "ok", "evidence"],
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "ok": { "const": true },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rollback": { "type": "string", "minLength": 1 },
    "audit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "step", "action", "actor", "risk", "evidence"],
        "properties": {
          "at": { "type": "integer", "minimum": 0 },
          "step": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "enum": ["R0", "R1", "R2", "R3"] },
          "evidence": { "type": "string", "minLength": 1 },
          "prev": { "type": "string" }
        }
      }
    },
    "finishedAt": { "type": "integer", "minimum": 0 }
  }
}
